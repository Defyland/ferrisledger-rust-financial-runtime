{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Defyland/ferrisledger-rust-financial-runtime/docs/events/pix_transfer_requested.v1.json",
  "title": "pix_transfer_requested v1",
  "type": "object",
  "required": ["event_id", "event_type", "stream_id", "tenant_id", "correlation_id", "schema_version", "occurred_at", "producer", "payload"],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": { "const": "pix_transfer_requested" },
    "stream_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "causation_id": { "type": ["string", "null"] },
    "schema_version": { "type": "integer", "const": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "const": "ferrisledger" },
    "payload": {
      "type": "object",
      "required": ["kind", "data"],
      "properties": {
        "kind": { "const": "pix_transfer_requested" },
        "data": {
          "type": "object",
          "required": ["tenant_id", "account_id", "amount", "beneficiary_pix_key", "idempotency_key"],
          "properties": {
            "tenant_id": { "type": "string" },
            "account_id": { "type": "string" },
            "amount": { "$ref": "#/$defs/money" },
            "beneficiary_pix_key": { "type": "string" },
            "idempotency_key": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "required": ["cents", "currency"],
      "properties": {
        "cents": { "type": "integer", "minimum": 1 },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
